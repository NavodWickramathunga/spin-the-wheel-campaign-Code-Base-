{
  "hosting": {
    "site": "stw-spin-wheel-1443",
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.@(html|js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ] }
    ],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "asia-southeast1" } }
    ]
  },
  "functions": [
    { "source": "functions", "codebase": "default", "ignore": ["node_modules", ".git", "*.local"] }
  ],
  "firestore": { "rules": "firestore.rules" },
  "emulators": {
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": false }
  }
}
